# Copy to .env and fill in. .env is git-ignored: never commit keys.
LLM_PROVIDER=gemini              # gemini | heuristic (offline lexical baseline)
GEMINI_API_KEY=                  # free key from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash    # any Gemini model your key can call
SEMANTIC_SCHOLAR_API_KEY=        # optional; raises the shared rate limit
CROSSREF_MAILTO=                 # your email, for Crossref's polite pool
RECORD_THRESHOLD=3
RELEVANCE_CUTOFF=0.6
